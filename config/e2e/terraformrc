# Terraform CLI config for the Coder provisioner in the Kind E2E (#369). CI fills the mirror once per job
# ("Mirror the Terraform coder provider into the Kind node") and mounts this directory read-only at
# /opt/coder-e2e/terraform through the CoderControlPlane's volumes. Every terraform init then installs
# coder/coder from the mirror and never from GitHub or the registry; other providers install as before.
provider_installation {
  filesystem_mirror {
    path    = "/opt/coder-e2e/terraform/mirror"
    include = ["registry.terraform.io/coder/coder"]
  }
  direct {
    exclude = ["registry.terraform.io/coder/coder"]
  }
}
